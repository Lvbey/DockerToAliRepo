#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.1.0"
CONFIG_FILE="${GDOCKER_CONFIG:-$HOME/.config/gdocker.conf}"
STATE_DIR="${GDOCKER_STATE_DIR:-$HOME/.local/state/gdocker}"
API_BASE="https://api.github.com"

usage() {
  cat <<'USAGE'
gdocker - mirror an upstream container image to Aliyun ACR or Tencent Cloud TCR through GitHub Actions.

Usage:
  gdocker pull [--registry aliyun|tencent] [--platform linux/amd64] IMAGE[:TAG]
  gdocker status
  gdocker logs
  gdocker config
  gdocker --version
  gdocker --help

Examples:
  gdocker pull nginx:1.27
  gdocker pull --registry tencent nginx:1.27
  gdocker pull --registry tencent --platform linux/amd64 redis:7.4.1
  gdocker pull ghcr.io/open-webui/open-webui:cuda
USAGE
}

die() { printf '[gdocker] ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '[gdocker] %s\n' "$*"; }
for cmd in curl jq docker flock sed sha256sum; do command -v "$cmd" >/dev/null 2>&1 || die "missing dependency: $cmd"; done

if [[ -r "$CONFIG_FILE" ]]; then
  # Keep this file root-owned and not writable by untrusted users.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi
GH_REPOSITORY="${GH_REPOSITORY:-Lvbey/DockerToAliRepo}"
GH_WORKFLOW_FILE="${GH_WORKFLOW_FILE:-docker.yaml}"
GH_REF="${GH_REF:-main}"
ALIYUN_REGISTRY="${ALIYUN_REGISTRY:-registry.cn-hangzhou.aliyuncs.com}"
ALIYUN_NAMESPACE="${ALIYUN_NAMESPACE:-lvbey}"
TENCENT_REGISTRY="${TENCENT_REGISTRY:-ccr.ccs.tencentyun.com}"
TENCENT_NAMESPACE="${TENCENT_NAMESPACE:-}"
DEFAULT_REGISTRY_PROVIDER="${DEFAULT_REGISTRY_PROVIDER:-aliyun}"
GH_TOKEN="${GH_TOKEN:-}"
WAIT_TIMEOUT_SECONDS="${WAIT_TIMEOUT_SECONDS:-900}"
POLL_INTERVAL_SECONDS="${POLL_INTERVAL_SECONDS:-5}"

mkdir -p "$STATE_DIR" "$STATE_DIR/locks"
chmod 700 "$STATE_DIR"
STATE_FILE="$STATE_DIR/last-run.json"

api_get() {
  curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
    -H "Authorization: Bearer $GH_TOKEN" -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" "$1"
}
require_config() {
  [[ -n "$GH_TOKEN" ]] || die "GH_TOKEN is not configured in $CONFIG_FILE"
  [[ "$GH_REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "invalid GH_REPOSITORY"
  [[ "$ALIYUN_NAMESPACE" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid ALIYUN_NAMESPACE"
  [[ "$DEFAULT_REGISTRY_PROVIDER" == aliyun || "$DEFAULT_REGISTRY_PROVIDER" == tencent ]] || die "DEFAULT_REGISTRY_PROVIDER must be aliyun or tencent"
}
normalise_image() {
  local image="$1" last
  [[ "$image" != -* && "$image" != *[[:space:]]* && "$image" != *@* ]] || die "only IMAGE[:TAG] is supported; digest references are not supported yet"
  [[ "$image" =~ ^[a-zA-Z0-9._:/-]+$ ]] || die "invalid image reference: $image"
  last="${image##*/}"; [[ "$last" == *:* ]] || image="$image:latest"
  printf '%s' "$image"
}
target_for() {
  local image="$1" platform="${2:-}" provider="${3:-$DEFAULT_REGISTRY_PROVIDER}" tag source_path first source_registry source_repo slug_registry slug_repo target_tag registry namespace
  image="$(normalise_image "$image")"; tag="${image##*:}"; source_path="${image%:*}"; first="${source_path%%/*}"
  if [[ "$source_path" != */* ]]; then
    source_registry=docker.io; source_repo="library/$source_path"
  elif [[ "$first" == *.* || "$first" == *:* || "$first" == localhost ]]; then
    source_registry="$first"; source_repo="${source_path#*/}"
  else
    source_registry=docker.io; source_repo="$source_path"
  fi
  source_registry="${source_registry,,}"; source_repo="${source_repo,,}"
  [[ "$source_registry" != index.docker.io ]] || source_registry=docker.io
  [[ "$source_registry" != docker.io || "$source_repo" == */* ]] || source_repo="library/$source_repo"
  slug_registry="${source_registry//./-}"; slug_registry="${slug_registry//:/-}"
  slug_repo="${source_repo//\//-}"
  target_repo="$(printf '%s-%s' "$slug_registry" "$slug_repo" | sed -E 's/[^a-z0-9._-]+/-/g; s/[-_.]{2,}/-/g; s/^[-_.]+//; s/[-_.]+$//')"
  (( ${#target_repo} >= 2 && ${#target_repo} <= 64 )) || die "mapped repository name must be 2-64 characters for ACR: $target_repo"
  target_tag="$tag"; [[ -z "$platform" ]] || target_tag="${tag}--${platform//\//-}"
  (( ${#target_tag} <= 128 )) || die "mapped image tag exceeds 128 characters"
  if [[ "$provider" == tencent ]]; then
    registry="${TENCENT_REGISTRY#https://}"; registry="${registry#http://}"
    namespace="$TENCENT_NAMESPACE"
    [[ -n "$namespace" ]] || die "TENCENT_NAMESPACE is required for Tencent TCR; configure it in $CONFIG_FILE"
    [[ "$namespace" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid TENCENT_NAMESPACE"
  elif [[ "$provider" == aliyun ]]; then
    registry="${ALIYUN_REGISTRY#https://}"; registry="${registry#http://}"
    namespace="$ALIYUN_NAMESPACE"
  else
    die "unsupported registry provider: $provider (use aliyun or tencent)"
  fi
  printf '%s\n' "$registry/$namespace/$target_repo:$target_tag"
}
save_state() {
  local request_id="$1" image="$2" run_id="$3" run_url="$4"
  jq -n --arg request_id "$request_id" --arg image "$image" --arg run_id "$run_id" --arg run_url "$run_url" \
    '{request_id:$request_id,image:$image,run_id:$run_id,run_url:$run_url,updated_at:(now|todate)}' > "$STATE_FILE"
  chmod 600 "$STATE_FILE"
}
cmd_status() {
  [[ -s "$STATE_FILE" ]] || die "no gdocker task recorded yet"
  local run_id request_id runs run_url image
  run_id="$(jq -r '.run_id // empty' "$STATE_FILE")"
  request_id="$(jq -r '.request_id // empty' "$STATE_FILE")"
  require_config
  if [[ -z "$run_id" && -n "$request_id" ]]; then
    runs="$(api_get "$API_BASE/repos/$GH_REPOSITORY/actions/workflows/$GH_WORKFLOW_FILE/runs?branch=$GH_REF&event=workflow_dispatch&per_page=20")"
    run_id="$(jq -r --arg id "$request_id" '[.workflow_runs[] | select((.display_title // "") | contains($id))] | first | .id // empty' <<< "$runs")"
    [[ -n "$run_id" ]] || die "workflow run is not visible yet; check GitHub Actions manually"
    run_url="$(jq -r --arg id "$request_id" '[.workflow_runs[] | select((.display_title // "") | contains($id))] | first | .html_url // empty' <<< "$runs")"
    image="$(jq -r '.image' "$STATE_FILE")"; save_state "$request_id" "$image" "$run_id" "$run_url"
  fi
  [[ -n "$run_id" ]] || die "workflow run ID is not available"
  api_get "$API_BASE/repos/$GH_REPOSITORY/actions/runs/$run_id" | jq '{id, display_title, status, conclusion, html_url, created_at, updated_at}'
}
cmd_logs() { [[ -s "$STATE_FILE" ]] || die "no gdocker task recorded yet"; jq -r '.run_url // "workflow URL not available yet"' "$STATE_FILE"; }

cmd_pull() {
  local platform="" provider="$DEFAULT_REGISTRY_PROVIDER" image="" arg request_id lock_file target run_id="" run_url="" start now payload runs status conclusion elapsed
  shift
  while (($#)); do
    arg="$1"
    case "$arg" in
      --registry) (($# >= 2)) || die "--registry requires aliyun or tencent"; provider="$2"; shift 2 ;;
      --registry=*) provider="${arg#*=}"; shift ;;
      --platform) (($# >= 2)) || die "--platform requires a value"; platform="$2"; shift 2 ;;
      --platform=*) platform="${arg#*=}"; shift ;;
      --help|-h) usage; return 0 ;;
      --*) die "unsupported option: $arg" ;;
      *) [[ -z "$image" ]] || die "only one image may be pulled at a time"; image="$arg"; shift ;;
    esac
  done
  [[ -n "$image" ]] || die "usage: gdocker pull [--registry aliyun|tencent] [--platform linux/amd64] IMAGE[:TAG]"
  [[ "$provider" == aliyun || "$provider" == tencent ]] || die "--registry must be aliyun or tencent"
  [[ -z "$platform" || "$platform" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)?$ ]] || die "invalid platform"
  require_config
  image="$(normalise_image "$image")"; target="$(target_for "$image" "$platform" "$provider")"
  lock_file="$STATE_DIR/locks/$(printf '%s' "$target" | sha256sum | awk '{print $1}').lock"
  exec 9>"$lock_file"; flock 9
  info "Source image: $image"; info "$provider image: $target"

  if ! docker manifest inspect "$target" >/dev/null 2>&1; then
    request_id="gdocker-$(date -u +%Y%m%d%H%M%S)-$$-$RANDOM"
    payload="$(jq -n --arg ref "$GH_REF" --arg image "$image" --arg platform "$platform" --arg provider "$provider" --arg request_id "$request_id" '{ref:$ref,inputs:{image:$image,platform:$platform,registry_provider:$provider,request_id:$request_id}}')"
    info "Dispatching GitHub Actions workflow (request $request_id)…"
    curl --fail --silent --show-error --connect-timeout 10 --max-time 30 -X POST \
      -H "Authorization: Bearer $GH_TOKEN" -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" -H "Content-Type: application/json" \
      --data "$payload" "$API_BASE/repos/$GH_REPOSITORY/actions/workflows/$GH_WORKFLOW_FILE/dispatches" >/dev/null
    save_state "$request_id" "$image" "" ""
    start="$(date +%s)"
    while (( $(date +%s) - start < 60 )); do
      runs="$(api_get "$API_BASE/repos/$GH_REPOSITORY/actions/workflows/$GH_WORKFLOW_FILE/runs?branch=$GH_REF&event=workflow_dispatch&per_page=20")"
      run_id="$(jq -r --arg id "$request_id" '[.workflow_runs[] | select((.display_title // "") | contains($id))] | first | .id // empty' <<< "$runs")"
      [[ -n "$run_id" ]] && break
      sleep 3
    done
    [[ -n "$run_id" ]] || die "workflow dispatched but run ID is not visible yet; run 'gdocker status' or check GitHub Actions"
    run_url="$(jq -r --argjson id "$run_id" '.workflow_runs[] | select(.id == $id) | .html_url' <<< "$runs" | head -n1)"
    save_state "$request_id" "$image" "$run_id" "$run_url"; info "Workflow: $run_url"
    start="$(date +%s)"
    while true; do
      now="$(date +%s)"; elapsed=$((now-start))
      (( elapsed < WAIT_TIMEOUT_SECONDS )) || die "timed out after ${elapsed}s; run 'gdocker status' or 'gdocker logs'"
      payload="$(api_get "$API_BASE/repos/$GH_REPOSITORY/actions/runs/$run_id")"
      status="$(jq -r '.status' <<< "$payload")"; conclusion="$(jq -r '.conclusion // empty' <<< "$payload")"
      if [[ "$status" == completed ]]; then [[ "$conclusion" == success ]] || die "workflow conclusion=$conclusion; see $run_url"; break; fi
      info "Workflow status: $status (${elapsed}s elapsed)"; sleep "$POLL_INTERVAL_SECONDS"
    done
  else
    info "Target image already exists in ACR; skipping mirror workflow."
  fi

  info "Pulling from $provider with native Docker…"
  if [[ -n "$platform" ]]; then docker pull --platform "$platform" "$target"; else docker pull "$target"; fi
  [[ "$image" == "$target" ]] || docker tag "$target" "$image"
  info "Done. Local image tag: $image"
}

case "${1:-}" in
  pull) cmd_pull "$@" ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  config)
    printf 'Config file: %s\nGitHub repository: %s\nWorkflow: %s\nRef: %s\nDefault registry provider: %s\nAliyun ACR: %s/%s\nTencent TCR: %s/%s\n' "$CONFIG_FILE" "$GH_REPOSITORY" "$GH_WORKFLOW_FILE" "$GH_REF" "$DEFAULT_REGISTRY_PROVIDER" "$ALIYUN_REGISTRY" "$ALIYUN_NAMESPACE" "$TENCENT_REGISTRY" "${TENCENT_NAMESPACE:-<not configured>}"
    [[ -n "$GH_TOKEN" ]] && echo 'GitHub token: configured' || echo 'GitHub token: MISSING'
    ;;
  --version|-V) echo "gdocker $VERSION" ;;
  --help|-h|"") usage ;;
  *) die "unknown command: $1 (use --help)" ;;
esac
